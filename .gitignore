# hc-patient-app — Ionic Angular + Capacitor
#
# This replaces the 2022 stock GitHub template that shipped with the initial commit. That file
# ignored neither `bin/` nor `.yo-repository/`, which is why this working tree read dirty from
# 2024 until 2026-08-21 and why `docs/CLAUDE.md` carried a standing note about it.

# --- node / angular ---------------------------------------------------------
node_modules/
/www/
/dist/
/.angular/
/coverage/
/test-results/
# Jest's cache and reporter output. Named `target/` to match the sibling repos' convention (the
# web repo is a JHipster client and writes its jest output there too), not because Maven is
# involved — there is no Java here.
/target/
*.log

# --- generated --------------------------------------------------------------
# Produced by tools/merge-i18n.mjs from src/i18n/<locale>/*.json. The per-feature
# bundles are the source; these merged ones are build output.
/src/assets/i18n/*.json
/src/environments/i18n-hash.ts

# --- capacitor --------------------------------------------------------------
# android/ and ios/ are committed on purpose — the manifest, permissions, build.gradle
# and network_security_config.xml are reviewable code and their diffs matter. Only the
# generated and machine-local parts are ignored.
/android/app/src/main/assets/public/
/ios/App/App/public/
/ios/App/public/
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/app/release/
/ios/App/Pods/
/ios/App/App/capacitor.config.json
# Xcode writes these on first open: per-user window state and breakpoints, never shared.
**/xcuserdata/
/ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# --- signing ----------------------------------------------------------------
# Never commit a keystore or its passwords. See patient-mobile.md §7 for where they live.
/android/keystore.properties
*.keystore
*.jks
# …and any renamed copy of one. `*.jks` does not match `hc-patient.jks.orphaned-20260911`, which is
# exactly the name a keystore gets while being replaced — so the one moment the rule is needed most
# was the one moment it did not fire. `git status` listed a signing key as untracked on 2026-09-11.
*.jks.*
*.keystore.*

# --- archaeology ------------------------------------------------------------
# A JHipster-Ionic 8.2.1 generator installed 2024-06-06 and never run. patient-mobile.md §6
# records the decision to discard it: it predates every decision in this repo.
/bin/
/.yo-repository/

# --- local ------------------------------------------------------------------
.env
.env.*
.DS_Store
Thumbs.db
.idea/
.vscode/
