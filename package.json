{
  "name": "hc-patient-app",
  "version": "0.0.1",
  "private": true,
  "description": "Health Connect Patient — mobile portal (Ionic Angular + Capacitor)",
  "license": "Apache-2.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "i18n": "node tools/merge-i18n.mjs",
    "prestart": "npm run i18n",
    "start": "ng serve",
    "prebuild": "npm run i18n",
    "build": "ng build --configuration development",
    "prebuild:prod": "npm run i18n",
    "build:prod": "ng build --configuration production",
    "pretest": "npm run i18n",
    "test": "jest --config jest.config.js",
    "test:watch": "npm run test -- --watch",
    "test:ci": "jest --config jest.config.js --ci --coverage --maxWorkers=2",
    "lint": "eslint . --ext .js,.mjs,.ts",
    "lint:fix": "npm run lint -- --fix",
    "prettier:check": "prettier --check \"{,src/**/,tools/**/}*.{md,json,yml,html,cjs,mjs,js,ts,css,scss}\"",
    "prettier:format": "prettier --write \"{,src/**/,tools/**/}*.{md,json,yml,html,cjs,mjs,js,ts,css,scss}\"",
    "provenance": "node tools/check-provenance.mjs ../web",
    "cap:sync": "npm run build:prod && npx cap sync android",
    "android:debug": "npm run cap:sync:dev && cd android && ./gradlew assembleDebug",
    "android:release": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "android:bundle": "npm run cap:sync && cd android && ./gradlew clean bundleRelease",
    "cap:sync:dev": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@angular/animations": "20.3.27",
    "@angular/common": "20.3.27",
    "@angular/compiler": "20.3.27",
    "@angular/core": "20.3.27",
    "@angular/forms": "20.3.27",
    "@angular/platform-browser": "20.3.27",
    "@angular/platform-browser-dynamic": "20.3.27",
    "@angular/router": "20.3.27",
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/angular": "9.0.0",
    "@ngx-translate/core": "15.0.0",
    "@ngx-translate/http-loader": "8.0.0",
    "dayjs": "1.11.10",
    "ionicons": "8.0.13",
    "rxjs": "7.8.1",
    "tslib": "2.6.2",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "17.1.1",
    "@angular-eslint/eslint-plugin-template": "17.1.1",
    "@angular-eslint/template-parser": "17.1.1",
    "@angular/build": "20.3.33",
    "@angular/cli": "20.3.33",
    "@angular/compiler-cli": "20.3.27",
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.2",
    "@typescript-eslint/eslint-plugin": "6.13.2",
    "@typescript-eslint/parser": "6.13.2",
    "eslint": "8.55.0",
    "eslint-config-prettier": "9.1.0",
    "jest": "30.4.2",
    "jest-date-mock": "1.0.8",
    "jest-environment-jsdom": "30.4.1",
    "jest-junit": "16.0.0",
    "jest-preset-angular": "15.0.0",
    "jsdom": "26.1.0",
    "prettier": "3.1.0",
    "rimraf": "5.0.5",
    "typescript": "5.9.3"
  }
}
